# ==============================================================================
# TRAVELMATE — CONFIGURATION D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier vers .env et renseignez vos clés API pour activer le mode réel.
# ==============================================================================

# --- Environnement Général ---
APP_NAME=TravelMate
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
API_V1_STR=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# --- Base de Données (PostgreSQL + PostGIS) ---
POSTGRES_USER=travelmate
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=travelmate_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://travelmate:change_me_in_production@postgres:5432/travelmate_db
DATABASE_URL_SYNC=postgresql+psycopg://travelmate:change_me_in_production@postgres:5432/travelmate_db

# --- Redis (Cache, File de tâches & Pub/Sub) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Sécurité, JWT & Chiffrement Coffre-Fort (AES-256-GCM) ---
JWT_SECRET_KEY=replace_with_64_char_random_hex_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Clé maîtresse (KEK) encodée en base64 (32 octets) pour le chiffrement enveloppe des documents
VAULT_MASTER_KEY=replace_with_32_byte_base64_encoded_master_key

# ==============================================================================
# ADAPTATEURS HYBRIDES DES SERVICES TIERS (simulated | real)
# Valeurs acceptées pour *_PROVIDER_MODE : "simulated" (défaut) ou "real"
# ==============================================================================

# 1. Service Gmail (Envoi de confirmation de réservation de billets d'avion)
GMAIL_PROVIDER_MODE=simulated
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
GMAIL_SENDER_EMAIL=

# 2. Service Google Calendar (Synchronisation des visites planifiées)
CALENDAR_PROVIDER_MODE=simulated
GOOGLE_CALENDAR_API_KEY=

# 3. Service Vols (Amadeus / Duffel)
FLIGHTS_PROVIDER_MODE=simulated
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_BASE_URL=https://test.api.amadeus.com

# 4. Service Météo (OpenWeatherMap / Open-Meteo)
WEATHER_PROVIDER_MODE=simulated
WEATHER_API_KEY=
WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# 5. Service IA (Générateur d'itinéraire & Assistant de chat contextuel)
AI_PROVIDER_MODE=simulated
AI_API_KEY=
AI_MODEL_NAME=gemini-2.5-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral

# 6. Service Lieux, Hébergements & Itinéraires (Google Places / Mapbox)
PLACES_PROVIDER_MODE=simulated
GOOGLE_PLACES_API_KEY=
MAPBOX_ACCESS_TOKEN=

# --- Règles Métier : Tampons de la Fenêtre du Séjour (en heures) ---
TRIP_ARRIVAL_BUFFER_HOURS=2.0
TRIP_DEPARTURE_BUFFER_HOURS=3.0

# --- Frontend (Vite PWA) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_HEALTH_URL=http://localhost:8000/health
